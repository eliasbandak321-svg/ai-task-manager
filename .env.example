# Copy to .env to change the defaults. .env is git-ignored; never commit real secrets.
# None of these use the VITE_ prefix: they are for the server only and never reach the browser.

# Port of the local API (the Vite dev server proxies /api to it).
# API_PORT=8787

# Leave unset to use the embedded PGlite database stored in PGLITE_DIR.
# Set it to use a real PostgreSQL server instead, e.g.:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_task_manager
# PGLITE_DIR=.data/pglite

# The single local user until accounts arrive in M7.
# DEV_USER_ID=00000000-0000-4000-8000-000000000001
