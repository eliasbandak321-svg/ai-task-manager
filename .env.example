# Copy to .env (git-ignored, keep it private: chmod 600 .env). Never commit real values.
# None of these use the VITE_ prefix: they are for the server only and never reach the browser.

# Which database the API uses. Required, no default (there is no silent fallback):
#   neon     this project's database (needs DATABASE_URL and NEON_BRANCH_ID below)
#   postgres any other PostgreSQL server (needs DATABASE_URL)
#   pglite   embedded offline database in PGLITE_DIR (or simply run `npm run dev:offline`)
DATABASE_PROVIDER=neon

# Neon PostgreSQL, development branch: the direct connection string from the Neon Console.
# Use sslmode=verify-full. Never point this at the production branch before M11.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

# The development branch's ID (Neon Console → Branches → development), e.g. br-xxxx-xxxx-123456.
# The API and migrations refuse to run against any other branch. Not a secret.
# NEON_BRANCH_ID=

# Emails (confirmation, password reset). Development only until M11:
#   console  printed in the API terminal (default)   file  JSON files in MAIL_DIR
# MAIL_TRANSPORT=console
# MAIL_DIR=.data/mail
# MAIL_FROM=AI Task Manager <no-reply@localhost>

# Client IP for rate limiting. Development default: trust this computer (the Vite proxy).
# Production must set one of these (see docs/architecture.md, M11 checklist).
# CLIENT_IP_HEADER=x-forwarded-for
# TRUSTED_PROXIES=

# Where the embedded PGlite database is stored when DATABASE_PROVIDER=pglite.
# PGLITE_DIR=.data/pglite

# Port of the local API (the Vite dev server proxies /api to it).
# API_PORT=8787

# Signs session cookies. Required. Secret: generate your own and never share it:
#   openssl rand -base64 32
# Changing it signs everyone out.
# BETTER_AUTH_SECRET=

# The address you open the app at. Auth cookies and the CSRF origin check depend on it.
# In development, the other names of this computer (127.0.0.1, [::1]) on the same port are
# accepted too. Must be https:// in production, where only this exact origin is trusted.
# APP_ORIGIN=http://localhost:5173

# AI features (M9). The default is the free, offline demo provider ("mock"): its answers are
# generated by simple rules from your own data and are labelled "Demo AI" in the app.
# The real provider (Claude API) costs money per request, paid from your Anthropic credits.
#   AI_PROVIDER=mock | anthropic
# AI_PROVIDER=mock
#
# Secret, server-only. Never use a VITE_ prefix, never commit it, never paste it in chat.
# Create it in the Anthropic Console (Settings → API keys); keep this file private (chmod 600).
# ANTHROPIC_API_KEY=
#
# Model (claude-haiku-5-5: $0.10 / $0.50 per million input / output tokens; cheapest).
# AI_MODEL=claude-haiku-5-5
# How much the model thinks; thinking tokens are billed as output: low | medium | high
# AI_EFFORT=low
#
# Cost guards. AI_BUDGET_USD is a hard cap on the app's total real-AI spending (all users,
# counted from the token usage the API reports); when reached, AI answers come from Demo AI.
# `npm run ai:usage` shows requests, tokens and cost so far.
# AI_BUDGET_USD=1
# AI requests per user per day, and the timeout for one provider call:
# AI_DAILY_REQUEST_LIMIT=20
# AI_TIMEOUT_MS=30000
