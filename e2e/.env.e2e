# Settings for the end-to-end tests (npm run test:e2e). Test values only — nothing secret.
# The tests never read .env, so they can't reach Neon or your data: they run on a fresh,
# temporary PGlite database, with emails saved as files the tests read.
NODE_ENV=development
DATABASE_PROVIDER=pglite
BETTER_AUTH_SECRET=e2e-test-secret-not-used-anywhere-else-0123456789
MAIL_TRANSPORT=file
API_PORT=8790
WEB_PORT=5175
APP_ORIGIN=http://localhost:5175
